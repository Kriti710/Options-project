# Copy to .env for local use. Never commit populated credentials.
DATABASE_URL=

# Times and rates follow docs/contracts.md.
DISPLAY_TIMEZONE=Asia/Kolkata
RISK_FREE_RATE_DECIMAL=
DIVIDEND_YIELD_DECIMAL=

# Data-quality and numerical thresholds (illustrative initial values).
MIN_OPTION_PREMIUM=0.05
MAX_STRIKE_DISTANCE_FROM_SPOT_DECIMAL=0.20
IV_SOLVER_TOLERANCE=0.000001
IV_SOLVER_MIN_VOLATILITY_DECIMAL=0.000001
IV_SOLVER_MAX_VOLATILITY_DECIMAL=5.0
IV_SOLVER_MAX_ITERATIONS=100
COLLECTION_REQUEST_DELAY_SECONDS=1.0
